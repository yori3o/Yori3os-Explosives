{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Adds explosives as a weapon and a useful tool.",
  "authors": [
    "Yori3o"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/yori3os-explosives",
    "sources": "https://github.com/yori3o/Yori3os-Explosives",
    "issues": "https://github.com/yori3o/Yori3os-Explosives/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.yori3o.yo_bombs.fabric.YoBombsFabric"
    ],
    "client": [
      "com.yori3o.yo_bombs.fabric.YoBombsFabricClient"
    ],
    "modmenu": [
      "com.yori3o.yo_bombs.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "yo_bombs.mixins.json"
  ],
  "depends": {
