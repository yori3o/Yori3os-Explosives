    "java": ">=${java}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/yori3os-explosives",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/yori3os-explosives"
      }
    }
